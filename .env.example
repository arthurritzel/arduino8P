# Copie para .env e ajuste se precisar. Todos têm valor padrão no docker-compose.yml.

# Broker e prefixo dos tópicos (o backend assina <prefixo>/+/dados e <prefixo>/+/status)
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_PREFIXO=silosmart/grupo01

# Porta do painel no seu computador: http://localhost:8088
PORTA_PAINEL=8088

# De quanto em quanto tempo o painel busca dados novos
FRONT_ATUALIZACAO_SEGUNDOS=5

# Sem leitura há mais que isso, o painel avisa
SEM_DADOS_APOS_SEGUNDOS=30

# Limites dos alertas
ALERTA_TEMPERATURA_MAX=30
ALERTA_UMIDADE_MAX=70

# Nome do silo usado pelo simulador
SIMULADOR_SILO=simulado
